# packages/ml is deliberately NOT an npm workspace member of the repo root, so that
# installs here can never collide with agents working in packages/core, apps/web or
# services/*. It keeps its own node_modules and package-lock.json.
#
# Always install from inside this directory with:
#     npm install --no-workspaces
#
# (npm ignores a `workspaces` key set in a project-level .npmrc, so it has to be the
# flag rather than a config line here.)
package-lock=true
