# Copy to .env and fill in. .env is gitignored — keep it that way.

# testnet | mainnet
CRUCIBLE_NETWORK=testnet

# Funding wallet for 0G Compute and 0G Storage.
# Use a throwaway key. Never put a wallet holding real value here, and never
# paste this key into a terminal you are recording.
PRIVATE_KEY=

# Orchestrator base URL, used by the CLI and the web app.
CRUCIBLE_API_URL=http://localhost:8787
